# 复制为根目录 .env 后填写真实值；.env 已被 Git 忽略。
# 五类业务 Chat 模型及独立解析视觉模型可以共用同一个服务 URL 和 Key，
# 但仍分别配置，方便后续按职责增量切换为不同模型。
# 以下各角色保留 DeepSeek 官方连接，作为切回备用；当前 model.yaml 使用后面的 BAILIAN_CHAT_*。
# 切换平台时须同时修改对应角色的 platform、model、URL 和 Key 引用，不删除另一套连接。

# 招标规则抽取模型连接信息。
RULE_EXTRACTION_MODEL_BASE_URL=https://api.deepseek.com
RULE_EXTRACTION_MODEL_API_KEY=replace-me

# 投标方资料入库 Agent 连接信息（沿用原配置名称）。
EVIDENCE_CLASSIFICATION_MODEL_BASE_URL=https://api.deepseek.com
EVIDENCE_CLASSIFICATION_MODEL_API_KEY=replace-me

# 投标文件项目相关性路由模型连接信息（不再生成摘要）。
BID_SUMMARY_MODEL_BASE_URL=https://api.deepseek.com
BID_SUMMARY_MODEL_API_KEY=replace-me

# 主审核 Agent 模型连接信息。
BID_CHAT_MODEL_BASE_URL=https://api.deepseek.com
BID_CHAT_MODEL_API_KEY=replace-me

# 资料核验子 Agent 模型连接信息。
EVIDENCE_CHAT_MODEL_BASE_URL=https://api.deepseek.com
EVIDENCE_CHAT_MODEL_API_KEY=replace-me

# 公共文档解析视觉辅助：DS V4.1 Flash 的实际多模态端点与模型 ID。
# 不给 view_image 工具使用；未启用视觉辅助时可留空。
PARSER_VISION_MODEL_BASE_URL=
PARSER_VISION_MODEL_API_KEY=
PARSER_VISION_MODEL_NAME=

# 检索模型：对应model.yaml中各自的platform:bailian。复制控制台实际API Host，
# 下面WORKSPACE_ID为占位符，必须替换；地域/工作空间/Key须一致。
# 使用百炼原生 /api/v1，不是Chat兼容 /compatible-api/v1；不追加具体服务路径。
EMBEDDING_BASE_URL=https://WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api/v1
EMBEDDING_API_KEY=replace-me
RERANK_BASE_URL=https://WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api/v1
RERANK_API_KEY=replace-me

# 当前六类 Chat 共用的百炼连接，与上面的 DS 官方变量互不覆盖。
# 使用现有北京地域兼容接口；如改工作空间域名，须同时核对模型能力登记。
# 此 Key 别名必须放在 EMBEDDING_API_KEY 定义之后，也可独立填写获授权的百炼 Key。
BAILIAN_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_CHAT_API_KEY=${EMBEDDING_API_KEY}

# 本地备选：同步将model.yaml对应块换成完整local示例，不能只换URL。
# EMBEDDING_BASE_URL=http://127.0.0.1:8081/v1
# EMBEDDING_API_KEY=local
# 本地Rerank进程内推理，无需RERANK_BASE_URL/RERANK_API_KEY，可留空；source是权重来源。
# 更换Embedding平台/地址/型号/维度需使用新索引；不自动清理旧数据。

# 可选运行设置。bool仅true启用，修改后重启；环境变量覆盖.env。
APP_DEBUG=false
APP_NAME=电力智能招标审核系统
# 外部Trace上传包含业务调用数据，按保密要求启用；关闭不影响审核。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dw-competition
