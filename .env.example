# 复制为根目录 .env 后填写真实值；.env 已被 Git 忽略。
# 四类 Chat 模型首期可以共用同一个百炼 URL 和 Key，
# 但仍分别配置，方便后续按职责增量切换为不同模型。

# 招标规则抽取模型连接信息。
RULE_EXTRACTION_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RULE_EXTRACTION_MODEL_API_KEY=replace-me

# 投标方资料分类模型连接信息。
EVIDENCE_CLASSIFICATION_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EVIDENCE_CLASSIFICATION_MODEL_API_KEY=replace-me

# 主审核 Agent 模型连接信息。
BID_CHAT_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BID_CHAT_MODEL_API_KEY=replace-me

# 资料核验子 Agent 模型连接信息。
EVIDENCE_CHAT_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EVIDENCE_CHAT_MODEL_API_KEY=replace-me

# 本地 llama.cpp Embedding 服务。Qwen3-Embedding-0.6B 原生输出 1024 维。
# 修改模型、URL 或维度后必须重建全部本地索引。
EMBEDDING_BASE_URL=http://127.0.0.1:8081/v1
EMBEDDING_API_KEY=local

# LangSmith 仅用于可选调试；关闭 tracing 时可以不填写 API Key。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dw-competition
