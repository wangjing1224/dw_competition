{
  "$defs": {
    "EvidenceReviewResult": {
      "additionalProperties": false,
      "properties": {
        "evidence_result_id": {
          "title": "Evidence Result Id",
          "type": "string"
        },
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "bidder_id": {
          "title": "Bidder Id",
          "type": "string"
        },
        "bid_file_id": {
          "title": "Bid File Id",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/EvidenceReviewStatus"
        },
        "evidence_found": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Evidence Found",
          "type": "array"
        },
        "missing_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Missing Evidence",
          "type": "array"
        },
        "consistency_issues": {
          "items": {
            "type": "string"
          },
          "title": "Consistency Issues",
          "type": "array"
        },
        "manual_review_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manual Review Reason"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "evidence_result_id",
        "claim_id",
        "task_id",
        "project_id",
        "bidder_id",
        "bid_file_id",
        "rule_id",
        "status",
        "summary"
      ],
      "title": "EvidenceReviewResult",
      "type": "object"
    },
    "EvidenceReviewStatus": {
      "enum": [
        "supported",
        "partially_supported",
        "unsupported",
        "contradicted",
        "ocr_required",
        "unverifiable",
        "weakly_related"
      ],
      "title": "EvidenceReviewStatus",
      "type": "string"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "bidder_id": {
          "title": "Bidder Id",
          "type": "string"
        },
        "bid_file_id": {
          "title": "Bid File Id",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "response_status": {
          "$ref": "#/$defs/ResponseStatus"
        },
        "category": {
          "$ref": "#/$defs/RuleCategory"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "result": {
          "$ref": "#/$defs/FindingResult"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "rule_source": {
          "$ref": "#/$defs/SourceRef"
        },
        "bid_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_result_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Result Id"
        },
        "check_results": {
          "items": {
            "$ref": "#/$defs/FindingCheckResult"
          },
          "title": "Check Results",
          "type": "array"
        },
        "suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggestion"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "finding_id",
        "task_id",
        "project_id",
        "bidder_id",
        "bid_file_id",
        "rule_id",
        "response_status",
        "category",
        "severity",
        "result",
        "title",
        "description",
        "rule_source",
        "confidence"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingCheckResult": {
      "additionalProperties": false,
      "description": "复合规则中单个检查项的结论。",
      "properties": {
        "item_key": {
          "title": "Item Key",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/FindingResult"
        },
        "actual_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Value"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "bid_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "item_key",
        "result",
        "description"
      ],
      "title": "FindingCheckResult",
      "type": "object"
    },
    "FindingResult": {
      "enum": [
        "compliant",
        "non_compliant",
        "risk",
        "manual_review"
      ],
      "title": "FindingResult",
      "type": "string"
    },
    "ResponseStatus": {
      "enum": [
        "found",
        "not_found",
        "not_applicable",
        "unreadable"
      ],
      "title": "ResponseStatus",
      "type": "string"
    },
    "RuleCategory": {
      "enum": [
        "format",
        "qualification",
        "commercial",
        "technical",
        "performance_capacity",
        "consistency_risk"
      ],
      "title": "RuleCategory",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "fatal",
        "major",
        "minor",
        "info",
        "unknown"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "file_id": {
          "title": "File Id",
          "type": "string"
        },
        "chunk_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Id"
        },
        "file_name": {
          "title": "File Name",
          "type": "string"
        },
        "source_path": {
          "title": "Source Path",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        }
      },
      "required": [
        "file_id",
        "file_name",
        "source_path"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "const": "record_batch",
      "title": "Action",
      "type": "string"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "file_id": {
      "title": "File Id",
      "type": "string"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "evidence_results": {
      "items": {
        "$ref": "#/$defs/EvidenceReviewResult"
      },
      "title": "Evidence Results",
      "type": "array"
    }
  },
  "required": [
    "action",
    "reason",
    "file_id",
    "summary",
    "findings"
  ],
  "title": "BatchAuditDecision",
  "type": "object"
}