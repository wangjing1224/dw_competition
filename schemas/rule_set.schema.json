{
  "$defs": {
    "RuleCategory": {
      "enum": [
        "format",
        "qualification",
        "commercial",
        "technical",
        "performance_capacity",
        "consistency_risk"
      ],
      "title": "RuleCategory",
      "type": "string"
    },
    "RuleItem": {
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/RuleProvenance"
        },
        "category": {
          "$ref": "#/$defs/RuleCategory"
        },
        "requirement": {
          "pattern": "\\S",
          "title": "Requirement",
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/RulePriority"
        },
        "verification": {
          "$ref": "#/$defs/VerificationLevel"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/RuleSourceFile"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "rule_id",
        "provenance",
        "category",
        "requirement",
        "priority",
        "verification",
        "reason",
        "sources"
      ],
      "title": "RuleItem",
      "type": "object"
    },
    "RulePriority": {
      "enum": [
        "critical",
        "important",
        "normal"
      ],
      "title": "RulePriority",
      "type": "string"
    },
    "RuleProvenance": {
      "enum": [
        "ai_generated",
        "human_added",
        "human_modified"
      ],
      "title": "RuleProvenance",
      "type": "string"
    },
    "RuleSourceFile": {
      "additionalProperties": false,
      "description": "从上传记录投影出的只读文件快照，不包含业务归属或切片。",
      "properties": {
        "file_id": {
          "pattern": "\\S",
          "title": "File Id",
          "type": "string"
        },
        "file_name": {
          "pattern": "\\S",
          "title": "File Name",
          "type": "string"
        },
        "source_path": {
          "pattern": "\\S",
          "title": "Source Path",
          "type": "string"
        }
      },
      "required": [
        "file_id",
        "file_name",
        "source_path"
      ],
      "title": "RuleSourceFile",
      "type": "object"
    },
    "VerificationLevel": {
      "enum": [
        "bid_only",
        "evidence_check"
      ],
      "title": "VerificationLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "project_profile": {
      "default": "",
      "title": "Project Profile",
      "type": "string"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/RuleItem"
      },
      "title": "Rules",
      "type": "array"
    },
    "source_files": {
      "items": {
        "$ref": "#/$defs/RuleSourceFile"
      },
      "title": "Source Files",
      "type": "array"
    }
  },
  "required": [
    "project_id"
  ],
  "title": "RuleSet",
  "type": "object"
}
