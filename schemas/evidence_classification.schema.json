{
  "$defs": {
    "ClassificationStatus": {
      "enum": [
        "classified",
        "manual_review"
      ],
      "title": "ClassificationStatus",
      "type": "string"
    },
    "EvidenceCatalogProfile": {
      "additionalProperties": false,
      "properties": {
        "rule_categories": {
          "items": {
            "$ref": "#/$defs/RuleCategory"
          },
          "title": "Rule Categories",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "verifiable_topics": {
          "items": {
            "type": "string"
          },
          "title": "Verifiable Topics",
          "type": "array"
        }
      },
      "required": [
        "summary"
      ],
      "title": "EvidenceCatalogProfile",
      "type": "object"
    },
    "EvidenceRetrievalProfile": {
      "additionalProperties": false,
      "properties": {
        "document_title": {
          "title": "Document Title",
          "type": "string"
        },
        "entities": {
          "items": {
            "type": "string"
          },
          "title": "Entities",
          "type": "array"
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        },
        "searchable_facts": {
          "items": {
            "type": "string"
          },
          "title": "Searchable Facts",
          "type": "array"
        }
      },
      "required": [
        "document_title"
      ],
      "title": "EvidenceRetrievalProfile",
      "type": "object"
    },
    "EvidenceType": {
      "enum": [
        "contract",
        "invoice",
        "invoice_verification",
        "certificate",
        "business_license",
        "technical_parameter",
        "test_report",
        "performance_table",
        "production_capacity",
        "personnel",
        "after_sales",
        "other"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "RuleCategory": {
      "enum": [
        "format",
        "qualification",
        "commercial",
        "technical",
        "performance_capacity",
        "consistency_risk"
      ],
      "title": "RuleCategory",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "evidence_type": {
      "$ref": "#/$defs/EvidenceType"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "classification_status": {
      "$ref": "#/$defs/ClassificationStatus"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "catalog_profile": {
      "$ref": "#/$defs/EvidenceCatalogProfile"
    },
    "retrieval_profile": {
      "$ref": "#/$defs/EvidenceRetrievalProfile"
    }
  },
  "required": [
    "evidence_type",
    "confidence",
    "classification_status",
    "reason",
    "catalog_profile",
    "retrieval_profile"
  ],
  "title": "EvidenceClassification",
  "type": "object"
}