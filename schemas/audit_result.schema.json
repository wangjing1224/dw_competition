{
  "$defs": {
    "ClassificationStatus": {
      "enum": [
        "classified",
        "manual_review"
      ],
      "title": "ClassificationStatus",
      "type": "string"
    },
    "DataRole": {
      "enum": [
        "rule_source",
        "evidence_material",
        "bid_document"
      ],
      "title": "DataRole",
      "type": "string"
    },
    "DocumentRef": {
      "additionalProperties": false,
      "properties": {
        "file_id": {
          "title": "File Id",
          "type": "string"
        },
        "file_name": {
          "title": "File Name",
          "type": "string"
        },
        "source_path": {
          "title": "Source Path",
          "type": "string"
        },
        "data_role": {
          "$ref": "#/$defs/DataRole"
        },
        "parse_status": {
          "$ref": "#/$defs/ParseStatus",
          "default": "pending"
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "bidder_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bidder Id"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "evidence_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "classification_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClassificationStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "file_id",
        "file_name",
        "source_path",
        "data_role"
      ],
      "title": "DocumentRef",
      "type": "object"
    },
    "EvidenceLibrary": {
      "additionalProperties": false,
      "properties": {
        "bidder_id": {
          "title": "Bidder Id",
          "type": "string"
        },
        "source_files": {
          "items": {
            "$ref": "#/$defs/EvidenceSourceFile"
          },
          "title": "Source Files",
          "type": "array"
        },
        "materials": {
          "items": {
            "$ref": "#/$defs/EvidenceMaterial"
          },
          "title": "Materials",
          "type": "array"
        }
      },
      "required": [
        "bidder_id"
      ],
      "title": "EvidenceLibrary",
      "type": "object"
    },
    "EvidenceMaterial": {
      "additionalProperties": false,
      "properties": {
        "bid_summary": {
          "description": "简洁说明当前文件的对象、可查事项及读取限制，不放图片路径，不下审核结论。",
          "minLength": 1,
          "title": "Bid Summary",
          "type": "string"
        },
        "evidence_summary": {
          "description": "当前文件完整的详细摘要：关键事实、对象编号、范围、局部读取限制及关联依据；看图获得且正文无转写的事实必须附真实图片路径，不因精简关系而省略，不写阅读批次等运行状态。",
          "minLength": 1,
          "title": "Evidence Summary",
          "type": "string"
        },
        "relations": {
          "description": "二元组列表：[一个简短关系短语, 已完成历史文件ID]。第一项自由填写而非枚举，只写是什么联系，不写解释句、编号、主体或数值；具体依据放evidence_summary。仅记录有依据且需联合理解或核验的联系，仅同一主体不建立关系，无明确联系填[]。",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "minLength": 1,
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Relations",
          "type": "array"
        },
        "file_id": {
          "title": "File Id",
          "type": "string"
        }
      },
      "required": [
        "bid_summary",
        "evidence_summary",
        "relations",
        "file_id"
      ],
      "title": "EvidenceMaterial",
      "type": "object"
    },
    "EvidenceSourceFile": {
      "additionalProperties": false,
      "properties": {
        "file_id": {
          "title": "File Id",
          "type": "string"
        },
        "file_name": {
          "title": "File Name",
          "type": "string"
        },
        "source_path": {
          "title": "Source Path",
          "type": "string"
        }
      },
      "required": [
        "file_id",
        "file_name",
        "source_path"
      ],
      "title": "EvidenceSourceFile",
      "type": "object"
    },
    "EvidenceType": {
      "enum": [
        "contract",
        "invoice",
        "invoice_verification",
        "certificate",
        "business_license",
        "technical_parameter",
        "test_report",
        "performance_table",
        "production_capacity",
        "personnel",
        "after_sales",
        "other"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "FileAuditResult": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "$ref": "#/$defs/DocumentRef"
        },
        "is_applicable": {
          "title": "Is Applicable",
          "type": "boolean"
        },
        "project_match": {
          "$ref": "#/$defs/ProjectMatch"
        },
        "exclusion_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exclusion Reason"
        },
        "overall_conclusion": {
          "$ref": "#/$defs/OverallConclusion"
        },
        "audit_summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audit Summary"
        },
        "category_summaries": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Category Summaries",
          "type": "object"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "suggestions": {
          "items": {
            "type": "string"
          },
          "title": "Suggestions",
          "type": "array"
        },
        "sources": {
          "additionalProperties": {
            "$ref": "#/$defs/ReadSource"
          },
          "title": "Sources",
          "type": "object"
        }
      },
      "required": [
        "file",
        "is_applicable",
        "project_match",
        "overall_conclusion"
      ],
      "title": "FileAuditResult",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/FindingResult"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "tender_chunk_ids": {
          "items": {
            "type": "string"
          },
          "title": "Tender Chunk Ids",
          "type": "array"
        },
        "bid_chunk_ids": {
          "items": {
            "type": "string"
          },
          "title": "Bid Chunk Ids",
          "type": "array"
        },
        "evidence_chunk_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Chunk Ids",
          "type": "array"
        },
        "image_paths": {
          "items": {
            "type": "string"
          },
          "title": "Image Paths",
          "type": "array"
        }
      },
      "required": [
        "rule_id",
        "result",
        "summary"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingResult": {
      "enum": [
        "compliant",
        "non_compliant",
        "risk",
        "manual_review"
      ],
      "title": "FindingResult",
      "type": "string"
    },
    "OverallConclusion": {
      "enum": [
        "compliant",
        "non_compliant",
        "risk",
        "manual_review",
        "not_applicable"
      ],
      "title": "OverallConclusion",
      "type": "string"
    },
    "ParseStatus": {
      "enum": [
        "pending",
        "parsed",
        "partial",
        "ocr_required",
        "unsupported",
        "manual_review"
      ],
      "title": "ParseStatus",
      "type": "string"
    },
    "ProjectMatch": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/ProjectMatchStatus"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "matched_fields": {
          "items": {
            "type": "string"
          },
          "title": "Matched Fields",
          "type": "array"
        },
        "conflicting_fields": {
          "items": {
            "type": "string"
          },
          "title": "Conflicting Fields",
          "type": "array"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "title": "ProjectMatch",
      "type": "object"
    },
    "ProjectMatchStatus": {
      "enum": [
        "matched",
        "not_matched",
        "uncertain"
      ],
      "title": "ProjectMatchStatus",
      "type": "string"
    },
    "ReadSource": {
      "additionalProperties": false,
      "description": "本次实际展示的来源快照，离开聊天历史仍能校验、导出。",
      "properties": {
        "file_id": {
          "title": "File Id",
          "type": "string"
        },
        "file_name": {
          "title": "File Name",
          "type": "string"
        },
        "source_path": {
          "title": "Source Path",
          "type": "string"
        },
        "data_role": {
          "title": "Data Role",
          "type": "string"
        },
        "parse_version": {
          "title": "Parse Version",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "page_numbers": {
          "items": {
            "type": "integer"
          },
          "title": "Page Numbers",
          "type": "array"
        },
        "quote": {
          "default": "",
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "file_id",
        "file_name",
        "source_path",
        "data_role",
        "parse_version"
      ],
      "title": "ReadSource",
      "type": "object"
    },
    "RuleCategory": {
      "enum": [
        "format",
        "qualification",
        "commercial",
        "technical",
        "performance_capacity",
        "consistency_risk"
      ],
      "title": "RuleCategory",
      "type": "string"
    },
    "RulePriority": {
      "enum": [
        "critical",
        "important",
        "normal"
      ],
      "title": "RulePriority",
      "type": "string"
    },
    "RuleReportItem": {
      "additionalProperties": false,
      "description": "报告中的规则快照，按 rule_id 拼接审核结论。",
      "properties": {
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/RuleCategory"
        },
        "requirement": {
          "title": "Requirement",
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/RulePriority"
        },
        "verification": {
          "$ref": "#/$defs/VerificationLevel"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "source_file_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source File Ids",
          "type": "array"
        }
      },
      "required": [
        "rule_id",
        "category",
        "requirement",
        "priority",
        "verification",
        "reason",
        "source_file_ids"
      ],
      "title": "RuleReportItem",
      "type": "object"
    },
    "VerificationLevel": {
      "enum": [
        "bid_only",
        "evidence_check"
      ],
      "title": "VerificationLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "bidder_id": {
      "title": "Bidder Id",
      "type": "string"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/RuleReportItem"
      },
      "title": "Rules",
      "type": "array"
    },
    "evidence_library": {
      "$ref": "#/$defs/EvidenceLibrary"
    },
    "rule_source_files": {
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Rule Source Files",
      "type": "array"
    },
    "file_results": {
      "items": {
        "$ref": "#/$defs/FileAuditResult"
      },
      "title": "File Results",
      "type": "array"
    },
    "file_errors": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "File Errors",
      "type": "object"
    }
  },
  "required": [
    "task_id",
    "project_id",
    "bidder_id",
    "evidence_library",
    "file_results"
  ],
  "title": "AuditResult",
  "type": "object"
}
