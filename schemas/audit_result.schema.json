{
  "$defs": {
    "BidDocumentSummary": {
      "additionalProperties": false,
      "description": "代码补充文件身份后的持久化摘要。",
      "properties": {
        "match_status": {
          "title": "Match Status",
          "type": "string"
        },
        "match_reason": {
          "title": "Match Reason",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "file_id": {
          "title": "File Id",
          "type": "string"
        }
      },
      "required": [
        "match_status",
        "match_reason",
        "summary",
        "file_id"
      ],
      "title": "BidDocumentSummary",
      "type": "object"
    },
    "ClassificationStatus": {
      "enum": [
        "classified",
        "manual_review"
      ],
      "title": "ClassificationStatus",
      "type": "string"
    },
    "DataRole": {
      "enum": [
        "rule_source",
        "evidence_material",
        "bid_document"
      ],
      "title": "DataRole",
      "type": "string"
    },
    "DocumentRef": {
      "additionalProperties": false,
      "properties": {
        "file_id": {
          "title": "File Id",
          "type": "string"
        },
        "file_name": {
          "title": "File Name",
          "type": "string"
        },
        "source_path": {
          "title": "Source Path",
          "type": "string"
        },
        "data_role": {
          "$ref": "#/$defs/DataRole"
        },
        "parse_status": {
          "$ref": "#/$defs/ParseStatus",
          "default": "pending"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "bidder_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bidder Id"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "evidence_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "classification_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClassificationStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "file_id",
        "file_name",
        "source_path",
        "data_role",
        "project_id"
      ],
      "title": "DocumentRef",
      "type": "object"
    },
    "EvidenceClassificationRecord": {
      "additionalProperties": false,
      "description": "代码补充文件 ID 后保存到最终结果，不进入主 Agent 输入。",
      "properties": {
        "evidence_type": {
          "$ref": "#/$defs/EvidenceType"
        },
        "classification_status": {
          "$ref": "#/$defs/ClassificationStatus"
        },
        "reason": {
          "maxLength": 500,
          "minLength": 2,
          "title": "Reason",
          "type": "string"
        },
        "bid_summary": {
          "maxLength": 500,
          "minLength": 2,
          "title": "Bid Summary",
          "type": "string"
        },
        "evidence_summary": {
          "maxLength": 2000,
          "minLength": 2,
          "title": "Evidence Summary",
          "type": "string"
        },
        "file_id": {
          "title": "File Id",
          "type": "string"
        },
        "file_name": {
          "title": "File Name",
          "type": "string"
        }
      },
      "required": [
        "evidence_type",
        "classification_status",
        "reason",
        "bid_summary",
        "evidence_summary",
        "file_id",
        "file_name"
      ],
      "title": "EvidenceClassificationRecord",
      "type": "object"
    },
    "EvidenceType": {
      "enum": [
        "contract",
        "invoice",
        "invoice_verification",
        "certificate",
        "business_license",
        "technical_parameter",
        "test_report",
        "performance_table",
        "production_capacity",
        "personnel",
        "after_sales",
        "other"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "FileAuditResult": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "$ref": "#/$defs/DocumentRef"
        },
        "is_applicable": {
          "title": "Is Applicable",
          "type": "boolean"
        },
        "project_match": {
          "$ref": "#/$defs/ProjectMatch"
        },
        "document_summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/BidDocumentSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "exclusion_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exclusion Reason"
        },
        "overall_conclusion": {
          "$ref": "#/$defs/OverallConclusion"
        },
        "audit_summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audit Summary"
        },
        "category_summaries": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Category Summaries",
          "type": "object"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "suggestions": {
          "items": {
            "type": "string"
          },
          "title": "Suggestions",
          "type": "array"
        }
      },
      "required": [
        "file",
        "is_applicable",
        "project_match",
        "overall_conclusion"
      ],
      "title": "FileAuditResult",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/FindingResult"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "tender_chunk_ids": {
          "items": {
            "type": "string"
          },
          "title": "Tender Chunk Ids",
          "type": "array"
        },
        "bid_chunk_ids": {
          "items": {
            "type": "string"
          },
          "title": "Bid Chunk Ids",
          "type": "array"
        },
        "evidence_chunk_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Chunk Ids",
          "type": "array"
        }
      },
      "required": [
        "rule_id",
        "result",
        "summary"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingResult": {
      "enum": [
        "compliant",
        "non_compliant",
        "risk",
        "manual_review"
      ],
      "title": "FindingResult",
      "type": "string"
    },
    "OverallConclusion": {
      "enum": [
        "compliant",
        "non_compliant",
        "risk",
        "manual_review",
        "not_applicable"
      ],
      "title": "OverallConclusion",
      "type": "string"
    },
    "ParseStatus": {
      "enum": [
        "pending",
        "parsed",
        "partial",
        "ocr_required",
        "unsupported",
        "manual_review"
      ],
      "title": "ParseStatus",
      "type": "string"
    },
    "ProjectMatch": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/ProjectMatchStatus"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "matched_fields": {
          "items": {
            "type": "string"
          },
          "title": "Matched Fields",
          "type": "array"
        },
        "conflicting_fields": {
          "items": {
            "type": "string"
          },
          "title": "Conflicting Fields",
          "type": "array"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "title": "ProjectMatch",
      "type": "object"
    },
    "ProjectMatchStatus": {
      "enum": [
        "matched",
        "not_matched",
        "uncertain"
      ],
      "title": "ProjectMatchStatus",
      "type": "string"
    },
    "RuleCategory": {
      "enum": [
        "format",
        "qualification",
        "commercial",
        "technical",
        "performance_capacity",
        "consistency_risk"
      ],
      "title": "RuleCategory",
      "type": "string"
    },
    "RulePriority": {
      "enum": [
        "critical",
        "important",
        "normal"
      ],
      "title": "RulePriority",
      "type": "string"
    },
    "RuleReportItem": {
      "additionalProperties": false,
      "description": "最终 JSON 顶层保存的规则快照，供 Word 按 rule_id 展示。",
      "properties": {
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/RuleCategory"
        },
        "requirement": {
          "maxLength": 500,
          "minLength": 8,
          "title": "Requirement",
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/RulePriority"
        },
        "verification": {
          "$ref": "#/$defs/VerificationLevel"
        },
        "evidence_types": {
          "items": {
            "$ref": "#/$defs/EvidenceType"
          },
          "title": "Evidence Types",
          "type": "array"
        }
      },
      "required": [
        "rule_id",
        "category",
        "requirement",
        "priority",
        "verification"
      ],
      "title": "RuleReportItem",
      "type": "object"
    },
    "VerificationLevel": {
      "enum": [
        "bid_only",
        "source_check",
        "evidence_check",
        "cross_check"
      ],
      "title": "VerificationLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "bidder_id": {
      "title": "Bidder Id",
      "type": "string"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/RuleReportItem"
      },
      "title": "Rules",
      "type": "array"
    },
    "evidence_classifications": {
      "items": {
        "$ref": "#/$defs/EvidenceClassificationRecord"
      },
      "title": "Evidence Classifications",
      "type": "array"
    },
    "file_results": {
      "items": {
        "$ref": "#/$defs/FileAuditResult"
      },
      "title": "File Results",
      "type": "array"
    }
  },
  "required": [
    "task_id",
    "project_id",
    "bidder_id",
    "file_results"
  ],
  "title": "AuditResult",
  "type": "object"
}
